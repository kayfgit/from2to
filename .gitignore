# Build output. Regenerated by `cargo build`; currently ~500 MB here.
/target/

# Backup files left by older rustfmt / rustc
**/*.rs.bk

# MSVC debug symbols
*.pdb

# Coverage and profiling output
*.profraw
*.profdata
/coverage/
tarpaulin-report.*

# Editors and IDEs
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Secrets and local environment
.env
.env.local
*.pem
*.key
*.p12
*.pfx
!.env.example

# Claude Code personal overrides. A project-level .claude/settings.json is
# meant to be shared, so it is deliberately not ignored.
.claude/settings.local.json

# Personal working notes. These are mine, not the project's — a public repo is
# not the place for a private runbook or a scratch todo list.
.release-runbook.html
todos.md
NOTES.md
/notes/
/scratch/

# Signing and deploy keys. Nothing here should ever hold one, but a stray
# `cp ~/.ssh/aur .` while setting up the AUR would otherwise be one `git add -A`
# away from publishing a private key.
id_rsa*
id_ed25519*
*_rsa
*_ed25519
!*.pub
*.gpg
*.asc
secring.*

# Scratch
*.log

# Cargo.lock is deliberately NOT ignored. The convention splits on crate type:
# ignore it for libraries, commit it for binaries and CLIs, so a build from any
# commit resolves to the exact dependency versions that were tested here.
