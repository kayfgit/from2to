# Build output. Regenerated by `cargo build`; currently ~500 MB here.
/target/

# Backup files left by older rustfmt / rustc
**/*.rs.bk

# MSVC debug symbols
*.pdb

# Coverage and profiling output
*.profraw
*.profdata
/coverage/
tarpaulin-report.*

# Editors and IDEs
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Secrets and local environment
.env
.env.local
*.pem
*.key
*.p12
*.pfx
!.env.example

# Claude Code personal overrides. A project-level .claude/settings.json is
# meant to be shared, so it is deliberately not ignored.
.claude/settings.local.json

# Scratch
*.log

# Cargo.lock is deliberately NOT ignored. The convention splits on crate type:
# ignore it for libraries, commit it for binaries and CLIs, so a build from any
# commit resolves to the exact dependency versions that were tested here.
